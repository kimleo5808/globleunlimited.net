---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerHero from '../components/answer/AnswerHero.astro';
import ClueTiles from '../components/answer/ClueTiles.astro';
import RevealPanel from '../components/answer/RevealPanel.astro';
import CountryPlate from '../components/answer/CountryPlate.astro';
import Countdown from '../components/answer/Countdown.astro';
import AnswerCards from '../components/answer/AnswerCards.astro';
import { answerForDate, shiftISO } from '../lib/game/daily';
import { COUNTRIES } from '../lib/game/countries';
import { flagUrl } from '../lib/game/flag-img';
import { prettyDate } from '../lib/game/hint';
import { analyse, teaserFor } from '../lib/game/analysis';
import { archiveDates, cardsFor, dispatchNoFor, todayISO } from '../lib/game/archive';
import { SITE } from '../lib/site';

const today = todayISO();
const country = answerForDate(today);
const analysis = analyse(country);
const nice = prettyDate(today);
const dispatchNo = dispatchNoFor(today);

const yesterday = shiftISO(today, -1);
const hasYesterday = yesterday >= SITE.launchDate;
const yCountry = hasYesterday ? answerForDate(yesterday) : null;

const allDates = archiveDates(today);
const recent = cardsFor(allDates.slice(-9, -1)); // last 8 completed days
const totalArchived = allDates.length;

const total = COUNTRIES.length;
const { ladder, bestOpener, obscurity } = analysis;

const title = 'Globle Answer Today – Hints First, Then the Reveal';
const description =
  'The Globle answer today with four hints before the spoiler, a country profile, the opening guess that finds it fastest, and every past answer.';

const features: Array<[string, string]> = [
  ['New country every day', 'One mystery country per day, the same for everyone, rolling over at 00:00 UTC.'],
  ['Guessing is by distance', 'Every guess is scored on the great-circle distance from its centre to the target.'],
  ['Colour shows how close', 'Pale yellow is roughly 9,000 km away; the darkest red means you are almost on top of it.'],
  ['Unlimited rounds too', 'The daily is one puzzle. Unlimited mode deals a new country the moment you finish.'],
  ['Your streak is yours', 'Stats live in your browser, not on our servers, so there is no account to make.'],
];

const faqs: Array<[string, string]> = [
  [
    'What is the Globle answer today?',
    `Today's mystery country on Globle Unlimited is revealed on this page behind a spoiler button, after four optional hints. The puzzle changes at 00:00 UTC, and this page is rebuilt at 00:05 UTC every day so the answer shown is always the current one.`,
  ],
  [
    'What time does the Globle answer change?',
    'The daily country rolls over at 00:00 UTC. That is 8:00 PM ET the previous evening, 5:00 PM PT the previous afternoon, 1:00 AM in the UK and Ireland during summer time, and 10:00 AM in eastern Australia.',
  ],
  [
    'Is this the official Globle answer?',
    'No. This is the answer to Globle Unlimited’s own daily puzzle. Globle Unlimited is an independent fan-made project and is not affiliated with the official Globle by Trainwreck Labs, which draws a different country each day.',
  ],
  [
    'How many guesses is a good Globle score?',
    `Most regular players finish between five and eight guesses. Four or fewer means your opening guess and your continent narrowing are both working. Today's country, for example, can be isolated to ${bestOpener.remaining} candidate${bestOpener.remaining === 1 ? '' : 's'} by a single well-chosen first guess.`,
  ],
  [
    'Does Globle repeat countries?',
    `The daily answer is drawn from a pool of ${total} countries and territories, seeded by the date, so a country can reappear after a while. The archive on this site lists every past answer, which is the quickest way to check whether one has already come up.`,
  ],
  [
    'What is the Globle Capitals answer today?',
    'Globle Capitals is a separate mode that hides a capital city instead of a country. It runs on its own rotation, so its answer is different from the country puzzle. You can play it any time without waiting for a daily reset.',
  ],
];

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: `${SITE.url}/globle-answer-today`,
    dateModified: today,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Globle Answer Today', item: `${SITE.url}/globle-answer-today` },
    ],
  },
];
---

<BaseLayout title={title} description={description} path="/globle-answer-today" schema={schema}>
  <AnswerHero
    dispatch={`DISPATCH NO. ${dispatchNo}`}
    dateLabel={nice}
    date={today}
    titleLead="Globle Answer"
    titleAccent="Today"
    teaser={teaserFor(country)}
    live
  />

  <p class="positioning container">
    The endless country-guessing globe game — the Globle answer today, every day at 00:00 UTC,
    plus unlimited rounds whenever you want them.
  </p>

  <!-- ── The core block: clues, then the reveal ── -->
  <section class="core container">
    <h2 class="core-head">Globle Answer Today: Clues &amp; Reveal ({today})</h2>

    <h3 class="sub mono">Globle {dispatchNo} Clues</h3>
    <ClueTiles ladder={ladder} total={total} />

    <h3 class="sub mono">Globle {dispatchNo} Answer</h3>
    <RevealPanel>
      <p class="answer">
        The Globle answer today, {nice}, is
        <strong><img class="flag-img" src={flagUrl(country.cca2)} alt="" width="28" height="20" decoding="async" /> {country.name}</strong>.
      </p>
      <CountryPlate country={country} analysis={analysis} date={today} />
    </RevealPanel>

    <p class="deeplink">
      <span aria-hidden="true">ⓘ</span>
      <a href="#why-hard">
        Read the full analysis — why it rates {obscurity.score}/5 and which opening guess finds it fastest
      </a>
    </p>
  </section>

  <Countdown />

  <!-- ── Recent answers ── -->
  <section class="container">
    <h2 class="centred">Recent Globle Answers</h2>
    <p class="centred lede-sm">
      Every past daily, with the hints that narrowed it and the opening guess that would have
      cracked it fastest.
    </p>
    <AnswerCards cards={recent} />
    <p class="centred">
      <a href="/globle-answer-archive" class="btn btn-ghost">Browse all {totalArchived} answers →</a>
    </p>
  </section>

  <!-- ══ Everything below here is the written guide ══ -->
  <article class="prose page">
    <h2>What Is Globle?</h2>
    <p>
      Globle is a country-guessing game played on a 3D globe. One country is hidden each day, and
      every guess you make is coloured by how far it sits from the target — so the map itself tells
      you whether you are getting warmer.
    </p>
    <p>
      That daily country is what people mean when they search for the Globle answer today: one
      puzzle, shared worldwide, replaced on a fixed schedule.
    </p>

    <ol class="features">
      {features.map(([h, body], i) => (
        <li>
          <span class="f-num mono">{i + 1}</span>
          <h3>{h}</h3>
          <p>{body}</p>
        </li>
      ))}
    </ol>

    <h2>How the Hints Narrow It Down</h2>
    <p>
      The four clues above are ordered weakest first, so each one still removes a meaningful slice
      of the field. Leading with the first letter would collapse the count to one immediately and
      make the rest pointless.
    </p>

    <figure class="plate-fig">
      <img
        src="/assets/answer/fig-1-hint-funnel.svg"
        alt="Funnel chart showing the four hints cutting the field from 176 countries to about 41, then 10, then 7, then 1"
        width="1000"
        height="560"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Mean candidates remaining after each hint, measured across the answer archive.</figcaption>
    </figure>

    <h2 id="why-hard">Why Today&rsquo;s Answer Was Hard</h2>

    <h3>Obscurity rating</h3>
    <p>
      Today&rsquo;s country rates <strong>{obscurity.score} of 5 — {obscurity.label}</strong>. Two
      things make a country hard to find in a distance game: it is small, so it is easy to
      overshoot, and it has few land neighbours, so there is no dense cluster of near-misses to
      walk in from.
    </p>
    <p>
      The rating weights size and neighbour count 65/35. This country ranks
      {' '}{obscurity.areaRank} of {total} by land area with {analysis.neighbours} land
      neighbour{analysis.neighbours === 1 ? '' : 's'}.
    </p>

    <h4>How many countries share its colour band</h4>
    <p>
      After the best possible opening guess, <strong>{bestOpener.remaining} countr{bestOpener.remaining === 1 ? 'y is' : 'ies are'}</strong>
      {' '}still close enough in distance that you could not tell them apart by colour alone.
    </p>

    <h3>The opening guess that would have found it fastest</h3>
    <p>
      Of every country larger than 100,000 km², <strong>{bestOpener.name}</strong> is the single
      best opener against today&rsquo;s answer, sitting
      {' '}{bestOpener.distanceKm.toLocaleString('en-US')} km away.
    </p>
    <p>
      This is hindsight, not a strategy — you cannot know the best opener before you know the
      answer. It is here because it shows how much a single guess can be worth, and how unevenly
      that value is spread across the map.
    </p>

    <h2>How to Solve Tomorrow Without Looking It Up</h2>

    <h3>Start central, not coastal</h3>
    <p>
      A guess in the middle of the landmass splits the world more evenly than one in a corner.
      Greece averages 5,464 km to every other country; New Zealand averages 13,976 km and tells
      you almost nothing. We ranked every candidate in
      <a href="/blog/best-globle-starting-country"> the best Globle starting country</a>.
    </p>

    <h3>Read the heat ramp</h3>
    <p>
      Colour is distance, and the scale is not linear in usefulness — the gap between two pale
      yellows is thousands of kilometres, while two deep reds may be neighbours.
    </p>

    <h4>What each colour band means in kilometres</h4>
    <p>
      The ramp spans 0 to 12,000 km across five stops. Pale yellow is roughly 9,000 km or more,
      orange sits near 6,000, deep orange near 3,000, and the darkest red means you are within a
      few hundred kilometres. The <a href="/how-to-play">how-to-play guide</a> shows the full
      scale.
    </p>

    <h3>Triangulate with two distant guesses</h3>
    <p>
      One guess gives you a ring. Two widely separated guesses give you the small lens where those
      rings cross, which is usually a handful of countries.
    </p>

    <h4>The two-guess lens trick</h4>
    <p>
      Pick your second guess roughly 90 degrees around the globe from your first, not next door to
      it. Two readings from nearly the same place produce nearly the same ring and waste a turn.
      The <a href="/blog/globle-tips-strategy">strategy guide</a> works through the mid-game from
      there.
    </p>

    <h2>When Does the Globle Answer Reset?</h2>
    <p>
      At 00:00 UTC, every day, worldwide. Because that is a fixed instant rather than a local
      midnight, the puzzle changes at a different clock time depending on where you are.
    </p>

    <figure class="plate-fig">
      <img
        src="/assets/answer/fig-2-reset-clock.svg"
        alt="24-hour dial showing the 00:00 UTC reset as 8:00 PM US Eastern, 5:00 PM US Pacific, 1:00 AM UK and Ireland, 2:00 AM Central Europe and 10:00 AM Sydney"
        width="1000"
        height="560"
        loading="lazy"
        decoding="async"
      />
      <figcaption>The same instant, read off five different local clocks.</figcaption>
    </figure>

    <h3>Reset time in your timezone</h3>
    <table class="tz">
      <thead>
        <tr><th>Region</th><th>Local reset time</th></tr>
      </thead>
      <tbody>
        <tr><td>US Eastern</td><td class="mono">8:00 PM (previous day)</td></tr>
        <tr><td>US Pacific</td><td class="mono">5:00 PM (previous day)</td></tr>
        <tr><td>UK &amp; Ireland</td><td class="mono">1:00 AM (BST/IST)</td></tr>
        <tr><td>Central Europe</td><td class="mono">2:00 AM (CEST)</td></tr>
        <tr><td>Sydney</td><td class="mono">10:00 AM (AEST)</td></tr>
      </tbody>
    </table>

    <h2 id="vs-official">Globle Unlimited vs the Official Globle</h2>
    <p>
      <strong>The two games do not share an answer.</strong> The Globle answer today on this page
      is Globle Unlimited&rsquo;s own daily puzzle. The original Globle, made by Trainwreck Labs,
      runs a completely separate rotation, and we are not affiliated with or endorsed by it.
    </p>

    <h3>What is the same</h3>
    <p>
      Both hide one country on a 3D globe and colour your guesses by great-circle distance, hotter
      as you close in. If you can play one, you can play the other.
    </p>

    <h3>What is different</h3>
    <p>
      The original serves one puzzle a day and then asks you to wait. This site keeps the daily but
      adds <a href="/">unlimited rounds</a> alongside it, which is the reason it exists. Two
      independent rotations means two different countries on any given date.
    </p>

    <h2>How We Work Out the Globle Answer Today</h2>

    <h3>The answer is computed, not typed in</h3>
    <p>
      Nobody on our side plays the puzzle and writes the result down. The day&rsquo;s country is
      derived from the date itself through a fixed seed — the same mechanism the game uses to serve
      every player the identical daily. This page reads that function directly, so the Globle
      answer today cannot drift out of sync with what the game is running.
    </p>
    <p>
      It also means the archive is reconstructable rather than recorded. Any past day can be
      recomputed exactly, which is why there are no gaps in it.
    </p>

    <h3>Where the hint counts and ratings come from</h3>
    <p>
      Every figure on this page — the {total}-country pool, the candidates remaining at each rung,
      the difficulty rating, the best opening guess and its distance — is calculated at build time
      from the game&rsquo;s own dataset, using the same great-circle formula that colours your
      guesses. The formulas are stated in the open next to the numbers they produce.
    </p>
    <p>
      That matters because several sites publishing a Globle answer today have carried stale or
      simply wrong countries for days at a stretch. A number you can check beats a number you have
      to trust.
    </p>

    {hasYesterday && yCountry && (
      <>
        <h2>Yesterday&rsquo;s Globle Answer</h2>
        <p>
          The answer for <a href={`/globle-answer-archive/${yesterday}`}>{prettyDate(yesterday)}</a>
          {' '}was <strong><img class="flag-img" src={flagUrl(yCountry.cca2)} alt="" width="28" height="20" loading="lazy" decoding="async" /> {yCountry.name}</strong>.
        </p>
      </>
    )}

    <h2>Globle Capitals Answer Today</h2>
    <p>
      <a href="/capitals">Globle Capitals</a> is the sibling mode: same globe, same heat colouring,
      but the hidden target is a capital city rather than a country. It runs unlimited rather than
      once a day, so there is no single daily answer to look up.
    </p>
    <p>
      That makes it the better mode for practice. Cities cluster far more tightly than countries,
      so reading small colour differences is a skill that transfers straight back to the country
      game.
    </p>

    <h2>Globle Answer Today: FAQ</h2>
    <div class="faq">
      {faqs.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>

    <p class="byline">
      Written by the Globle Unlimited team. Hint counts, obscurity ratings and opening-guess
      figures are computed at build time from the game&rsquo;s own {total}-country dataset using
      the same great-circle distance the game scores with.
      <br />
      <span class="mono">Last updated {nice}</span>
    </p>
  </article>
</BaseLayout>

<style>
  .positioning {
    text-align: center;
    color: var(--text-mute);
    font-size: var(--fs-small);
    font-style: italic;
    padding-block: var(--space-6);
    max-width: 64ch;
  }

  /* ---- core clue + reveal block ---- */
  .core {
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6);
    max-width: var(--wide-width);
  }
  .core-head {
    text-align: center;
    font-size: var(--fs-h2);
    margin-bottom: var(--space-8);
  }
  .sub {
    text-align: center;
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-mute);
    margin-block: var(--space-8) var(--space-3);
  }
  .answer { font-size: 1.2rem; color: var(--text); margin-block: var(--space-6); text-align: center; }
  .deeplink {
    text-align: center;
    margin-top: var(--space-6);
    font-size: var(--fs-small);
    color: var(--text-mute);
  }
  .deeplink a { color: var(--accent); }

  .centred { text-align: center; }
  .lede-sm { color: var(--text-dim); font-size: var(--fs-small); max-width: 60ch; margin-inline: auto; }

  /* ---- written guide ---- */
  .page { padding-block: var(--space-12); }

  .features {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-4);
  }
  .features li {
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-4);
  }
  .f-num {
    display: inline-grid;
    place-items: center;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg-deep);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .features h3 {
    font-size: var(--fs-small);
    margin: var(--space-3) 0 var(--space-2);
    color: var(--text);
  }
  .features p { color: var(--text-dim); font-size: var(--fs-small); margin: 0; }

  .plate-fig { margin: var(--space-6) 0; }
  .plate-fig img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .plate-fig figcaption {
    margin-top: var(--space-2);
    color: var(--text-mute);
    font-size: var(--fs-small);
    text-align: center;
  }

  .tz { width: 100%; border-collapse: collapse; margin: var(--space-4) 0; font-size: var(--fs-small); }
  .tz th, .tz td { border: 1px solid var(--line); padding: var(--space-2) var(--space-3); text-align: left; }
  .tz th { background: var(--bg-panel); color: var(--accent); }
  .tz td { color: var(--text-dim); }

  .faq { display: flex; flex-direction: column; gap: var(--space-2); margin-top: var(--space-4); }
  .faq details {
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }
  .faq summary { cursor: pointer; color: var(--text); font-weight: 600; }
  .faq p { margin-top: var(--space-2); color: var(--text-dim); }

  .byline {
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    color: var(--text-mute);
    font-size: var(--fs-small);
  }

  @media (max-width: 640px) {
    .core { padding: var(--space-6) var(--space-4); border-radius: var(--radius); }
  }
</style>
