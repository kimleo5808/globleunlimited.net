---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobeGame from '../components/game/GlobeGame.astro';

const title = 'Globle Capitals – Guess the Capital City Game';
const description =
  'Play Globle Capitals: guess the mystery capital city on a 3D globe with unlimited rounds. A tougher twist on Globle Unlimited for geography buffs.';

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Globle Capitals',
    genre: 'Geography puzzle',
    gamePlatform: 'Web browser',
    applicationCategory: 'Game',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is Globle Capitals?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Globle Capitals is a variant where the mystery answer is a capital city. You guess capital cities and the distance between them guides you to the answer.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do you play Globle Capitals?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Type any capital city. Each guess appears on the globe coloured by how close it is to the mystery capital — hotter is closer — until you find it.',
        },
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} path="/capitals" schema={schema}>
  <section class="hero">
    <div class="container hero-inner">
      <h1 class="hero-title rise" style="--d:0ms">Globle Capitals</h1>
      <p class="hero-sub rise" style="--d:80ms">
        Guess the mystery <strong>capital city</strong> — unlimited rounds.
      </p>
      <GlobeGame mode="capitals" />
    </div>
  </section>

  <article class="prose content">
    <h2>What Is Globle Capitals?</h2>
    <p>
      <strong>Globle Capitals is a tougher twist on Globle where the mystery answer is a capital
      city instead of a country.</strong> You type capital cities, and each guess lights up on the
      globe as a marker coloured by how far it sits from the target capital — hotter means closer.
      It tests not just where countries are, but where their capitals actually lie.
    </p>

    <h2>How to Play Globle Capitals</h2>
    <ol>
      <li><strong>Type any capital city</strong> (for example, Paris or Tokyo) and press Enter.</li>
      <li><strong>Read the marker colour.</strong> Pale yellow is far from the mystery capital;
        deep red is very close.</li>
      <li><strong>Use the distance</strong> to the closest capital so far to steer your next guess.</li>
      <li><strong>Find the capital</strong> in as few guesses as possible — then play again.</li>
    </ol>

    <h2>Capitals vs Countries</h2>
    <p>
      Country borders are large targets; capitals are single points, so distances are sharper and
      the game rewards precise geographic knowledge. If you enjoy <a href="/">Globle Unlimited</a>,
      Capitals is the natural next challenge. New here? Start with the
      <a href="/how-to-play">how-to-play guide</a> to learn how the colour heatmap works.
    </p>

    <p class="cta-row"><a href="/" class="btn btn-ghost">Play Globle Unlimited</a></p>
  </article>
</BaseLayout>

<style>
  .hero { padding-block: var(--space-12) var(--space-8); }
  .hero-inner { text-align: center; max-width: 760px; }
  .hero-title { font-size: var(--fs-display); }
  .hero-sub { color: var(--text-dim); font-size: 1.15rem; margin-top: var(--space-3); }
  .rise { animation-delay: var(--d, 0ms); }
  .content { margin-top: var(--space-16); text-align: left; }
  .content ol { color: var(--text-dim); margin: var(--space-4) 0; padding-left: var(--space-6); display: flex; flex-direction: column; gap: var(--space-2); }
  .cta-row { margin-top: var(--space-8); }
</style>
