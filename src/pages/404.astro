---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found – Globle Unlimited';
const description = 'That page drifted off the map. Head back to Globle Unlimited and keep guessing.';
---

<BaseLayout title={title} description={description} path="/404">
  <section class="notfound">
    <div class="container nf-inner">
      <p class="code mono">404</p>
      <h1>This page drifted off the map.</h1>
      <p class="sub">The country you were looking for isn&rsquo;t here — but the globe is still spinning.</p>
      <div class="actions">
        <a href="/" class="btn btn-primary">▶ Play Globle Unlimited</a>
        <a href="/how-to-play" class="btn btn-ghost">How to Play</a>
      </div>
      <nav class="links">
        <a href="/daily">Daily</a> · <a href="/globle-answer-today">Today&rsquo;s Answer</a> ·
        <a href="/blog">Blog</a> · <a href="/about">About</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound { padding-block: var(--space-16); display: grid; place-items: center; min-height: 60vh; }
  .nf-inner { text-align: center; max-width: 560px; }
  .code { font-size: clamp(3rem, 12vw, 6rem); color: var(--accent); line-height: 1; }
  h1 { font-size: var(--fs-h1); margin-top: var(--space-4); }
  .sub { color: var(--text-dim); margin-top: var(--space-3); font-size: 1.1rem; }
  .actions { display: flex; gap: var(--space-3); justify-content: center; margin-top: var(--space-8); flex-wrap: wrap; }
  .links { margin-top: var(--space-8); color: var(--text-mute); font-size: var(--fs-small); }
  .links a { color: var(--text-dim); }
</style>
