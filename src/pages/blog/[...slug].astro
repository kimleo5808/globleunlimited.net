---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const url = `${SITE.url}/blog/${post.id}`;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    author: { '@type': 'Organization', name: post.data.author },
    publisher: { '@type': 'Organization', name: SITE.name },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE.url + '/blog' },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---

<BaseLayout title={`${post.data.title} | Globle Unlimited`} description={post.data.description} path={`/blog/${post.id}`} schema={schema}>
  <div class="post-wrap">
    <header class="post-head">
      <p class="crumb"><a href="/">Home</a> › <a href="/blog">Blog</a> › {post.data.title}</p>
      <h1>{post.data.title}</h1>
      <p class="byline mono">
        By {post.data.author} · {fmt(post.data.date)}
        {post.data.updated && <> · Updated {fmt(post.data.updated)}</>}
      </p>

      {post.data.cover && (
        <img
          class="cover"
          src={post.data.cover}
          alt={post.data.coverAlt ?? post.data.title}
          width="1200"
          height="630"
          fetchpriority="high"
        />
      )}
    </header>

    <div class="post-cols">
      <aside class="post-aside">
        <TableOfContents headings={headings} />
      </aside>

      <article>
        <div class="post-body">
          <Content />
        </div>

        <hr />
        <p class="cta-row"><a href="/" class="btn btn-primary">▶ Play Globle Unlimited</a></p>
        <p><a href="/blog">← Back to all posts</a></p>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  /* Header spans the full measure; the cover is allowed to run wider than the
     720px text column so a long read opens like a magazine spread. */
  .post-wrap { padding-block: var(--space-12); }
  .post-head {
    width: min(100% - 2 * var(--space-6), var(--wide-width));
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }
  .crumb { font-size: var(--fs-small); color: var(--text-mute); margin-bottom: var(--space-4); }
  .crumb a { color: var(--text-dim); }
  h1 { font-size: var(--fs-h1); margin-bottom: var(--space-2); }
  .byline { color: var(--text-mute); font-size: var(--fs-small); margin-bottom: var(--space-8); }

  .cover { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-panel); }

  /* One column until there is genuinely room for a rail beside the text. */
  .post-cols {
    width: min(100% - 2 * var(--space-6), var(--content-width));
    margin-inline: auto;
  }
  .post-aside { margin: 0; }

  @media (min-width: 1100px) {
    .post-cols {
      width: min(100% - 2 * var(--space-6), var(--wide-width));
      display: grid;
      grid-template-columns: 232px minmax(0, 1fr);
      gap: var(--space-12);
      align-items: start;
    }
    .post-cols > article { min-width: 0; max-width: var(--content-width); }
    /* The rail is sticky inside this column, so the column has to span the
       full row — a content-height grid item would scroll away with it. */
    .post-aside { align-self: stretch; }
  }

  /* Atlas plates: body illustrations framed with a gold hairline */
  .post-body :global(img) { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--bg-panel); margin: var(--space-6) auto var(--space-2); }
  /* Figcaption convention: an emphasized line immediately following a plate */
  .post-body :global(img + em) { display: block; text-align: center; color: var(--text-mute); font-size: var(--fs-small); font-style: normal; margin-top: var(--space-2); margin-bottom: var(--space-6); }

  /* Margin notes: blockquotes as atlas callouts */
  .post-body :global(blockquote) { margin: var(--space-6) 0; padding: var(--space-4) var(--space-5); background: var(--accent-dim); border-left: 3px solid var(--accent); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .post-body :global(blockquote p) { margin-bottom: 0; color: var(--text-dim); }
  .post-body :global(blockquote p + p) { margin-top: var(--space-2); }

  /* Inline FAQ: details/summary panels matching the answer pages */
  .post-body :global(details) { background: var(--bg-panel); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: var(--space-3) var(--space-4); margin: var(--space-2) 0; }
  .post-body :global(summary) { cursor: pointer; color: var(--text); font-weight: 600; }
  .post-body :global(details p) { margin: var(--space-2) 0 0; }

  .post-body :global(tr:hover td) { background: var(--accent-dim); }

  .post-body :global(h2) { font-family: var(--font-display); font-size: var(--fs-h2); margin-top: var(--space-12); margin-bottom: var(--space-4); padding-left: var(--space-4); border-left: 3px solid var(--accent); }
  .post-body :global(h3) { font-size: var(--fs-h3); color: var(--text); margin-top: var(--space-8); margin-bottom: var(--space-2); }
  /* H4 is a fourth level of detail, not a heading with presence: quieter than
     h3 and unmarked, so the h2 rail stays the only structural signal. */
  .post-body :global(h4) { font-size: 1rem; font-weight: 700; color: var(--text-dim); margin-top: var(--space-6); margin-bottom: var(--space-2); }
  .post-body :global(p) { color: var(--text-dim); margin-bottom: var(--space-4); }
  .post-body :global(ul), .post-body :global(ol) { color: var(--text-dim); margin: var(--space-4) 0; padding-left: var(--space-6); display: flex; flex-direction: column; gap: var(--space-2); }
  .post-body :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .post-body :global(strong) { color: var(--text); }
  .post-body :global(table) { width: 100%; border-collapse: collapse; margin: var(--space-6) 0; font-size: var(--fs-small); }
  .post-body :global(th), .post-body :global(td) { border: 1px solid var(--line); padding: var(--space-2) var(--space-3); text-align: left; }
  .post-body :global(th) { background: var(--bg-panel); color: var(--accent); }
  .post-body :global(td) { color: var(--text-dim); }

  hr { border: 0; border-top: 1px solid var(--line); margin: var(--space-12) 0 var(--space-6); }
  .cta-row { margin-bottom: var(--space-4); }
</style>
