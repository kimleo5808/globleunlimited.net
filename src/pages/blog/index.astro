---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../lib/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const title = 'Globle Blog – Tips, Strategy & Geography Games';
const description =
  'The Globle Unlimited blog: strategy guides, the hardest countries to guess, and the best geography games like Globle. Get better and play smarter.';

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Globle Unlimited Blog',
    description,
    url: `${SITE.url}/blog`,
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.description,
      datePublished: p.data.date.toISOString(),
      url: `${SITE.url}/blog/${p.id}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
    ],
  },
];
---

<BaseLayout title={title} description={description} path="/blog" schema={schema}>
  <section class="wrap">
    <header class="head">
      <p class="crumb"><a href="/">Home</a> › Blog</p>
      <h1>Globle <span class="accent">Blog</span></h1>
      <p class="lede">
        Strategy guides, geography deep-dives and the best games like Globle. Read up, then put it
        to work in <a href="/">Globle Unlimited</a>.
      </p>
      <p class="count mono">{posts.length} articles</p>
    </header>

    <ul class="grid">
      {posts.map((p, i) => (
        <li class="post">
          <a href={`/blog/${p.id}/`}>
            {p.data.cover && (
              <img
                class="cover"
                src={p.data.cover}
                alt={p.data.coverAlt ?? p.data.title}
                width="1200"
                height="630"
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
            )}
            <span class="body">
              <span class="date mono">{fmt(p.data.date)}</span>
              <h2>{p.data.title}</h2>
              <span class="desc">{p.data.description}</span>
              <span class="go">Read →</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .wrap {
    width: min(100% - 2 * var(--space-6), var(--wide-width));
    margin-inline: auto;
    padding-block: var(--space-12);
  }

  .head { max-width: 64ch; margin-bottom: var(--space-12); }
  .crumb { font-size: var(--fs-small); color: var(--text-mute); margin-bottom: var(--space-4); }
  .crumb a { color: var(--text-dim); }
  h1 { font-size: var(--fs-h1); margin-bottom: var(--space-4); }
  .accent { color: var(--accent); }
  .lede { font-size: 1.1rem; color: var(--text-dim); }
  .lede a { color: var(--accent); }
  .count {
    margin-top: var(--space-4);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-mute);
  }

  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .post > a {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .post > a:hover { transform: translateY(-3px); border-color: var(--accent); }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    background: var(--bg-panel-2);
    border-bottom: 1px solid var(--line);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    padding: var(--space-5);
  }

  .date { font-size: 0.72rem; color: var(--text-mute); letter-spacing: 0.06em; }

  h2 {
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--text);
    margin: 0;
  }

  /* Descriptions vary in length; clamping keeps every card in the row the
     same height without truncating in the markup, so the full text stays
     available to crawlers. */
  .desc {
    color: var(--text-dim);
    font-size: var(--fs-small);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .go {
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--accent);
    font-size: var(--fs-small);
    font-weight: 600;
  }

  @media (max-width: 1000px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; gap: var(--space-4); }
    .head { margin-bottom: var(--space-8); }
  }

  @media (prefers-reduced-motion: reduce) {
    .post > a { transition: none; }
  }
</style>
