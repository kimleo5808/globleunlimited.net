---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Your Globle Stats – Streaks & Best Scores';
const description =
  'See your Globle stats: daily streak, best guess count, games played, and your full guess distribution. Stored privately in your browser, never uploaded.';

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Where are my Globle stats stored?', acceptedAnswer: { '@type': 'Answer', text: 'Entirely in your own browser, using localStorage. Nothing is uploaded to a server, so there is no account to create and no data for us to see.' } },
      { '@type': 'Question', name: 'Why did my Globle streak reset to zero?', acceptedAnswer: { '@type': 'Answer', text: 'A daily streak counts consecutive days on which you finished the daily puzzle. Skipping a day resets the current streak, but your max streak is kept as a permanent record.' } },
      { '@type': 'Question', name: 'Do Unlimited rounds affect my daily streak?', acceptedAnswer: { '@type': 'Answer', text: 'No. Unlimited, Capitals and the daily challenge are tracked separately, so you can practise as much as you like without touching your daily streak.' } },
      { '@type': 'Question', name: 'What is a good average guess count in Globle?', acceptedAnswer: { '@type': 'Answer', text: 'Most regular players settle between five and eight guesses. Consistently finishing in four or fewer means your opening guess and your continent narrowing are both working well.' } },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://globleunlimited.net/' },
    { '@type': 'ListItem', position: 2, name: 'Your Stats', item: 'https://globleunlimited.net/stats' },
  ]},
];
---

<BaseLayout title={title} description={description} path="/stats" schema={schema}>
  <section class="container stats-wrap">
    <h1 class="rise">Your Stats</h1>
    <p class="sub rise" style="--d:80ms">Saved privately in your browser — nothing leaves your device.</p>

    <div class="stat-blocks rise" style="--d:160ms">
      <section class="card stat-card">
        <h2>🔥 Daily</h2>
        <dl class="grid">
          <div><dt>Current streak</dt><dd class="mono" data-s="daily.currentStreak">0</dd></div>
          <div><dt>Max streak</dt><dd class="mono" data-s="daily.maxStreak">0</dd></div>
          <div><dt>Played</dt><dd class="mono" data-s="daily.played">0</dd></div>
          <div><dt>Best guesses</dt><dd class="mono" data-s="daily.bestGuesses">—</dd></div>
        </dl>
      </section>

      <section class="card stat-card">
        <h2>♾️ Unlimited</h2>
        <dl class="grid">
          <div><dt>Wins</dt><dd class="mono" data-s="unlimited.wins">0</dd></div>
          <div><dt>Played</dt><dd class="mono" data-s="unlimited.played">0</dd></div>
          <div><dt>Best guesses</dt><dd class="mono" data-s="unlimited.bestGuesses">—</dd></div>
        </dl>
        <h3 class="dist-title">Guess distribution</h3>
        <div class="dist" data-dist="unlimited"></div>
      </section>

      <section class="card stat-card">
        <h2>🏛️ Capitals</h2>
        <dl class="grid">
          <div><dt>Wins</dt><dd class="mono" data-s="capitals.wins">0</dd></div>
          <div><dt>Played</dt><dd class="mono" data-s="capitals.played">0</dd></div>
          <div><dt>Best guesses</dt><dd class="mono" data-s="capitals.bestGuesses">—</dd></div>
        </dl>
        <h3 class="dist-title">Guess distribution</h3>
        <div class="dist" data-dist="capitals"></div>
      </section>
    </div>

    <p class="cta-row rise" style="--d:240ms"><a href="/" class="btn btn-primary">▶ Play Globle Unlimited</a></p>
  </section>

  <article class="prose explainer">
    <h2>What Each Stat Means</h2>
    <p>
      <strong>Every number above measures a different habit, not a single overall skill.</strong>
      Streaks reward showing up; guess counts reward reading the globe well. It is normal for one
      to look strong while the other lags, and knowing which is which tells you what to work on.
    </p>
    <ul>
      <li>
        <strong>Current streak</strong> — consecutive days you have finished the
        <a href="/daily">daily challenge</a>. Miss a day and it returns to zero.
      </li>
      <li>
        <strong>Max streak</strong> — the longest run you have ever put together. This one never
        goes down, so it stays as a personal record even after a reset.
      </li>
      <li>
        <strong>Played</strong> — how many rounds of that mode you have finished. Useful as a
        denominator: ten wins out of twelve rounds is a very different story from ten out of sixty.
      </li>
      <li>
        <strong>Best guesses</strong> — the fewest guesses you have ever needed to find the mystery
        country. Lucky first guesses count, so treat this as a ceiling rather than an average.
      </li>
      <li>
        <strong>Guess distribution</strong> — how often you finish in one guess, two, three, and so
        on. The shape matters more than any single bar: a tall cluster around four or five means
        your method is repeatable, while a flat spread means you are still guessing by instinct.
      </li>
    </ul>

    <h2>How Your Stats Are Stored</h2>
    <p>
      <strong>All of it lives in your own browser, in localStorage — nothing is uploaded.</strong>
      There is no account, no login and no server-side profile, which also means your stats are
      tied to one browser on one device. Playing on your phone builds a separate record from
      playing on your laptop, and clearing site data or using private browsing wipes the history.
      If you want the numbers to keep growing, stick to one browser. Our
      <a href="/privacy-policy">privacy policy</a> covers exactly what is and is not collected.
    </p>
    <p>
      Each mode is counted on its own. Unlimited and <a href="/capitals">Capitals</a> rounds never
      touch your daily streak, so you can practise as much as you want without putting a record at
      risk — that is the whole point of an unlimited mode.
    </p>

    <h2>How to Improve These Numbers</h2>
    <h3>Fix your opening guess first</h3>
    <p>
      The single biggest lever on your guess distribution is guess number one. A central,
      high-information starting country splits the world far more evenly than a corner country
      like New Zealand or Iceland. We ran the numbers on every candidate in
      <a href="/blog/best-globle-starting-country">the best Globle starting country</a>.
    </p>
    <h3>Narrow by continent before you narrow by country</h3>
    <p>
      Two well-spaced guesses usually pin down the right landmass. Only then is it worth spending
      guesses on individual neighbours. The full method is in our
      <a href="/blog/globle-tips-strategy">Globle tips and strategy guide</a>, and the colour scale
      itself is explained on <a href="/how-to-play">how to play</a>.
    </p>
    <h3>Practise the countries that keep beating you</h3>
    <p>
      Most players lose their streaks to the same handful of small or unfamiliar states. Run
      <a href="/practice">practice mode</a> until they stop surprising you, and see which ones
      trip up everyone else in
      <a href="/blog/hardest-countries-to-guess">the hardest countries to guess</a>.
    </p>
  </article>
</BaseLayout>

<script>
  import { getStats } from '../lib/game/stats';
  import type { GameMode } from '../lib/game/types';

  function set(path: string, value: string | number | null) {
    const el = document.querySelector(`[data-s="${path}"]`);
    if (el) el.textContent = value == null ? '—' : String(value);
  }

  (['daily', 'unlimited', 'capitals'] as GameMode[]).forEach((mode) => {
    const s = getStats(mode);
    set(`${mode}.currentStreak`, s.currentStreak);
    set(`${mode}.maxStreak`, s.maxStreak);
    set(`${mode}.played`, s.played);
    set(`${mode}.wins`, s.wins);
    set(`${mode}.bestGuesses`, s.bestGuesses);
  });

  // Distribution bars
  const keys = ['1', '2', '3', '4', '5', '6', '7+'];
  function renderDist(mode: GameMode) {
    const dist = getStats(mode).distribution;
    const max = Math.max(1, ...keys.map((k) => dist[k] ?? 0));
    const host = document.querySelector(`[data-dist="${mode}"]`);
    if (!host) return;
    host.innerHTML = keys
      .map((k) => {
        const n = dist[k] ?? 0;
        const pct = Math.round((n / max) * 100);
        return `<div class="dist-row"><span class="dist-k mono">${k}</span><span class="dist-bar" style="width:${Math.max(6, pct)}%">${n || ''}</span></div>`;
      })
      .join('');
  }
  renderDist('unlimited');
  renderDist('capitals');
</script>

<style>
  .stats-wrap { padding-block: var(--space-12); max-width: 1040px; }
  .stats-wrap h1 { font-size: var(--fs-h1); }
  .sub { color: var(--text-dim); margin-top: var(--space-2); }
  .rise { animation: rise var(--dur) var(--ease) both; animation-delay: var(--d, 0ms); }

  .stat-blocks { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-6); margin-top: var(--space-8); }
  .stat-card { padding: var(--space-6); }
  .stat-card h2 { font-size: var(--fs-h3); margin-bottom: var(--space-4); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .grid dt { font-size: var(--fs-small); color: var(--text-mute); }
  .grid dd { font-size: 1.6rem; color: var(--accent); }

  .dist-title { font-size: var(--fs-small); color: var(--text-mute); text-transform: uppercase; letter-spacing: 0.1em; margin: var(--space-6) 0 var(--space-3); }
  .dist { display: flex; flex-direction: column; gap: var(--space-2); }
  .dist :global(.dist-row) { display: grid; grid-template-columns: 24px 1fr; align-items: center; gap: var(--space-2); }
  .dist :global(.dist-k) { color: var(--text-dim); font-size: var(--fs-small); }
  .dist :global(.dist-bar) {
    background: var(--accent); color: var(--bg-deep); font-weight: 700;
    font-size: var(--fs-small); padding: 2px var(--space-2);
    border-radius: var(--radius-sm); text-align: right; min-width: 18px;
  }

  .cta-row { margin-top: var(--space-8); }

  .explainer { padding-bottom: var(--space-12); }
  .explainer ul { color: var(--text-dim); padding-left: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-4); }
  .explainer ul strong { color: var(--text); }

  @media (max-width: 640px) {
    .stat-blocks { grid-template-columns: 1fr; }
  }
</style>
