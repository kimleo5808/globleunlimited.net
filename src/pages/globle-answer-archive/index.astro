---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { answerForDate } from '../../lib/game/daily';
import { COUNTRIES, flag } from '../../lib/game/countries';
import { prettyDate } from '../../lib/game/hint';
import { obscurityOf } from '../../lib/game/analysis';
import { archiveDates, todayISO } from '../../lib/game/archive';
import { SITE } from '../../lib/site';

const today = todayISO();
const dates = archiveDates(today);

interface Row {
  date: string;
  nice: string;
  name: string;
  cca2: string;
  region: string;
  difficulty: number;
}

const rows: Row[] = dates
  .map((date) => {
    const c = answerForDate(date);
    return {
      date,
      nice: prettyDate(date),
      name: c.name,
      cca2: c.cca2,
      region: c.region || 'Other',
      difficulty: obscurityOf(c).score,
    };
  })
  .reverse(); // newest first

// Group by calendar month for sticky section headers.
const months: Array<{ key: string; label: string; rows: Row[] }> = [];
for (const row of rows) {
  const key = row.date.slice(0, 7);
  let group = months.find((m) => m.key === key);
  if (!group) {
    group = {
      key,
      label: new Date(`${key}-01T00:00:00Z`).toLocaleDateString('en-US', {
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      }),
      rows: [],
    };
    months.push(group);
  }
  group.rows.push(row);
}

const usedNames = new Set(rows.map((r) => r.name));
const unusedCount = COUNTRIES.length - usedNames.size;

// Which continent has supplied the most answers so far.
const regionTally = new Map<string, number>();
for (const r of rows) regionTally.set(r.region, (regionTally.get(r.region) ?? 0) + 1);
const topRegion = [...regionTally.entries()].sort((a, b) => b[1] - a[1])[0];

const REGIONS = [...regionTally.keys()].sort();

const neverUsed = COUNTRIES.filter((c) => !usedNames.has(c.name))
  .map((c) => c.name)
  .sort();

const title = 'Globle Answer Archive – Every Past Answer by Date';
const description =
  'Every past Globle Unlimited daily answer, searchable by country and filterable by continent, with difficulty ratings and the countries that have never come up.';

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: `${SITE.url}/globle-answer-archive`,
    dateModified: today,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Globle Answer Today', item: `${SITE.url}/globle-answer-today` },
      { '@type': 'ListItem', position: 3, name: 'Answer Archive', item: `${SITE.url}/globle-answer-archive` },
    ],
  },
];
---

<BaseLayout title={title} description={description} path="/globle-answer-archive" schema={schema}>
  <article class="prose wide page">
    <p class="crumb">
      <a href="/">Home</a> › <a href="/globle-answer-today">Globle Answer Today</a> › Archive
    </p>

    <h1>Globle Answer Archive</h1>
    <p class="lede">
      Every country that has been the Globle Unlimited daily answer since
      {' '}{prettyDate(SITE.launchDate)}. Search by name, filter by continent, or scan the
      difficulty column to find the days that caught people out.
    </p>

    <dl class="tally">
      <div><dt>Days archived</dt><dd class="mono">{rows.length}</dd></div>
      <div><dt>Countries used</dt><dd class="mono">{usedNames.size}</dd></div>
      <div><dt>Most common region</dt><dd class="mono">{topRegion ? topRegion[0] : '—'}</dd></div>
      <div><dt>Never appeared</dt><dd class="mono">{unusedCount}</dd></div>
    </dl>

    <div class="controls">
      <label class="search">
        <span class="sr-only">Search past answers by country or date</span>
        <input
          type="search"
          id="archive-search"
          placeholder="Search a country or date…"
          autocomplete="off"
        />
      </label>
      <div class="chips" role="group" aria-label="Filter by continent">
        <button type="button" class="chip is-on" data-region="all">All</button>
        {REGIONS.map((r) => (
          <button type="button" class="chip" data-region={r}>{r}</button>
        ))}
      </div>
    </div>

    <p class="empty" id="archive-empty" hidden>No answers match that search.</p>

    {months.map((month) => (
      <section class="month" data-month>
        <h2 class="month-head">{month.label}</h2>
        <ul class="index">
          {month.rows.map((row) => (
            <li data-row data-name={row.name.toLowerCase()} data-date={row.date} data-region={row.region}>
              <span class={`band band-${row.region.toLowerCase().replace(/[^a-z]/g, '')}`} aria-hidden="true"></span>
              <a href={`/globle-answer-archive/${row.date}`} class="row-date mono">{row.nice}</a>
              <span class="row-flag" aria-hidden="true">{flag(row.cca2)}</span>
              <span class="row-name">{row.name}</span>
              <span class="row-region">{row.region}</span>
              <span class="row-diff mono" title={`Difficulty ${row.difficulty} of 5`}>
                {'●'.repeat(row.difficulty)}<span class="dim">{'●'.repeat(5 - row.difficulty)}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <h2>Countries That Haven&rsquo;t Appeared Yet</h2>
    <p>
      {unusedCount} of the {COUNTRIES.length} countries in the pool have never been a daily
      answer. If you are keeping a personal streak, these are the ones worth learning before they
      turn up.
    </p>
    {neverUsed.length > 0 && (
      <details class="unused">
        <summary>Show all {unusedCount} countries still to come</summary>
        <p>{neverUsed.join(' · ')}</p>
      </details>
    )}

    <h2>How This Archive Works</h2>
    <h3>Where the answers come from</h3>
    <p>
      Each day&rsquo;s country is drawn deterministically from the date itself, so every player
      worldwide gets the same puzzle and the archive can be reconstructed exactly. Nothing here is
      entered by hand.
    </p>
    <h3>What the difficulty dots mean</h3>
    <p>
      Difficulty is rated 1 to 5 from land area and land-neighbour count, weighted 65/35 toward
      size. Small countries with few neighbours score highest because they are easy to overshoot
      and have no cluster of near-misses to walk in from.
    </p>

    <p class="cta-row">
      <a href="/globle-answer-today" class="btn btn-primary">See today&rsquo;s answer →</a>
      <a href="/" class="btn btn-ghost">▶ Play Globle Unlimited</a>
    </p>
  </article>
</BaseLayout>

<script>
  const search = document.getElementById('archive-search') as HTMLInputElement | null;
  const empty = document.getElementById('archive-empty');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-row]'));
  const months = Array.from(document.querySelectorAll<HTMLElement>('[data-month]'));
  const chips = Array.from(document.querySelectorAll<HTMLElement>('.chip'));

  let region = 'all';
  let query = '';

  function apply() {
    let shown = 0;
    for (const row of rows) {
      const matchesRegion = region === 'all' || row.dataset.region === region;
      const haystack = `${row.dataset.name} ${row.dataset.date}`;
      const matchesQuery = !query || haystack.includes(query);
      const show = matchesRegion && matchesQuery;
      row.hidden = !show;
      if (show) shown++;
    }
    // Hide a month heading once every row under it is filtered out.
    for (const month of months) {
      const any = Array.from(month.querySelectorAll<HTMLElement>('[data-row]')).some((r) => !r.hidden);
      month.hidden = !any;
    }
    if (empty) empty.hidden = shown > 0;
  }

  search?.addEventListener('input', () => {
    query = search.value.trim().toLowerCase();
    apply();
  });

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      region = chip.dataset.region ?? 'all';
      for (const c of chips) c.classList.toggle('is-on', c === chip);
      apply();
    });
  }
</script>

<style>
  .page { padding-block: var(--space-12); }
  .wide { width: min(100% - 2 * var(--space-6), var(--wide-width)); margin-inline: auto; }
  .crumb { font-size: var(--fs-small); color: var(--text-mute); margin-bottom: var(--space-4); }
  .crumb a { color: var(--text-dim); }
  h1 { font-size: var(--fs-h1); margin-bottom: var(--space-4); }
  .lede { font-size: 1.05rem; color: var(--text-dim); }

  .tally {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-4);
    margin: var(--space-8) 0;
    padding: var(--space-6);
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .tally dt { font-size: var(--fs-small); color: var(--text-mute); text-transform: uppercase; letter-spacing: 0.08em; }
  .tally dd { margin: var(--space-1) 0 0; color: var(--accent); font-size: 1.6rem; }

  .controls { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; margin-bottom: var(--space-8); }
  .search { flex: 1 1 260px; }
  .search input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line);
    padding: var(--space-3) var(--space-1);
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--fs-body);
  }
  .search input:focus {
    outline: none;
    border-bottom-color: var(--accent);
    box-shadow: 0 1px 0 0 var(--accent);
  }
  .search input::placeholder { color: var(--text-mute); }

  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chip {
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-3);
    color: var(--text-dim);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease);
  }
  .chip:hover { color: var(--text); border-color: var(--accent); }
  .chip.is-on { background: var(--accent-dim); border-color: var(--accent); color: var(--accent); }

  .empty { color: var(--text-mute); font-style: italic; }

  .month-head {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--bg-deep);
    margin: var(--space-8) 0 var(--space-3);
    padding: var(--space-2) 0 var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-mute);
    border-left: 3px solid var(--accent);
  }

  .index { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2px; }
  .index li {
    display: grid;
    grid-template-columns: 4px 150px 28px 1fr auto auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-panel);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    transition: transform var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .index li:hover { transform: translateX(4px); border-color: var(--line); }

  .band { width: 4px; height: 22px; border-radius: 2px; background: var(--text-mute); }
  .band-africa { background: var(--heat-1); }
  .band-asia { background: var(--heat-2); }
  .band-europe { background: var(--heat-3); }
  .band-americas { background: var(--heat-0); }
  .band-oceania { background: var(--globe-sea); }

  .row-date { color: var(--text-dim); font-size: var(--fs-small); text-decoration: none; }
  .row-date:hover { color: var(--accent); }
  .row-flag { font-size: 1.2rem; }
  .row-name { color: var(--text); font-weight: 600; }
  .row-region { color: var(--text-mute); font-size: var(--fs-small); }
  .row-diff { color: var(--accent); font-size: 0.7rem; letter-spacing: 1px; }
  .row-diff .dim { color: var(--text-mute); opacity: 0.35; }

  .unused { background: var(--bg-panel); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: var(--space-3) var(--space-4); }
  .unused summary { cursor: pointer; color: var(--accent); font-weight: 600; }
  .unused p { margin-top: var(--space-3); color: var(--text-dim); font-size: var(--fs-small); line-height: 1.9; }

  .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-block: var(--space-12) var(--space-3); }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  @media (max-width: 720px) {
    .index li { grid-template-columns: 4px 1fr auto; row-gap: var(--space-1); }
    .row-date { grid-column: 2 / -1; }
    .row-region { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .index li, .chip { transition: none; }
  }
</style>
