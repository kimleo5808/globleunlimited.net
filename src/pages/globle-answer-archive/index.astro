---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnswerCards from '../../components/answer/AnswerCards.astro';
import { COUNTRIES } from '../../lib/game/countries';
import { prettyDate } from '../../lib/game/hint';
import { archiveDates, cardsFor, todayISO } from '../../lib/game/archive';
import { SITE } from '../../lib/site';

const today = todayISO();
const dates = archiveDates(today);
const cards = cardsFor(dates); // newest first

// Group by calendar month so the grid keeps a sense of time.
const months: Array<{ key: string; label: string; cards: typeof cards }> = [];
for (const card of cards) {
  const key = card.date.slice(0, 7);
  let group = months.find((m) => m.key === key);
  if (!group) {
    group = {
      key,
      label: new Date(`${key}-01T00:00:00Z`).toLocaleDateString('en-US', {
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      }),
      cards: [],
    };
    months.push(group);
  }
  group.cards.push(card);
}

const usedNames = new Set(cards.map((c) => c.name));
const unusedCount = COUNTRIES.length - usedNames.size;

const regionTally = new Map<string, number>();
for (const c of cards) regionTally.set(c.region, (regionTally.get(c.region) ?? 0) + 1);
const topRegion = [...regionTally.entries()].sort((a, b) => b[1] - a[1])[0];
const REGIONS = [...regionTally.keys()].sort();

const neverUsed = COUNTRIES.filter((c) => !usedNames.has(c.name))
  .map((c) => c.name)
  .sort();

const title = 'Globle Answer Archive – Every Past Answer by Date';
const description =
  'Every past Globle Unlimited daily answer, searchable by country and filterable by continent, with difficulty ratings and the countries that have never come up.';

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: `${SITE.url}/globle-answer-archive`,
    dateModified: today,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Globle Answer Today', item: `${SITE.url}/globle-answer-today` },
      { '@type': 'ListItem', position: 3, name: 'Answer Archive', item: `${SITE.url}/globle-answer-archive` },
    ],
  },
];
---

<BaseLayout title={title} description={description} path="/globle-answer-archive" schema={schema}>
  <!-- ── Compact hero: stats and controls, no prose ── -->
  <section class="hero">
    <div class="container">
      <p class="crumb">
        <a href="/">Home</a> › <a href="/globle-answer-today">Globle Answer Today</a> › Archive
      </p>

      <h1>Globle Answer <span class="accent">Archive</span></h1>
      <p class="lede">
        Every country that has been the daily answer since {prettyDate(SITE.launchDate)}.
      </p>

      <dl class="tally">
        <div><dt>Days archived</dt><dd class="mono">{cards.length}</dd></div>
        <div><dt>Countries used</dt><dd class="mono">{usedNames.size}</dd></div>
        <div><dt>Most common region</dt><dd class="mono">{topRegion ? topRegion[0] : '—'}</dd></div>
        <div><dt>Never appeared</dt><dd class="mono">{unusedCount}</dd></div>
      </dl>

      <div class="controls">
        <label class="search">
          <span class="sr-only">Search past answers by country or date</span>
          <input type="search" id="archive-search" placeholder="Search a country or date…" autocomplete="off" />
        </label>
        <div class="chips" role="group" aria-label="Filter by continent">
          <button type="button" class="chip is-on" data-region="all">All</button>
          {REGIONS.map((r) => <button type="button" class="chip" data-region={r}>{r}</button>)}
        </div>
      </div>
    </div>
  </section>

  <section class="container grid-wrap">
    <p class="empty" id="archive-empty" hidden>No answers match that search.</p>

    {months.map((month) => (
      <div class="month" data-month>
        <h2 class="month-head mono">{month.label}</h2>
        <AnswerCards cards={month.cards} latestDate={today} />
      </div>
    ))}
  </section>

  <article class="prose page">
    <h2>Countries That Haven&rsquo;t Appeared Yet</h2>
    <p>
      {unusedCount} of the {COUNTRIES.length} countries in the pool have never been a daily answer.
      If you are keeping a personal streak, these are the ones worth learning before they turn up.
    </p>
    {neverUsed.length > 0 && (
      <details class="unused">
        <summary>Show all {unusedCount} countries still to come</summary>
        <p>{neverUsed.join(' · ')}</p>
      </details>
    )}

    <h2>How This Archive Works</h2>
    <h3>Where the answers come from</h3>
    <p>
      Each day&rsquo;s country is drawn deterministically from the date itself, so every player
      worldwide gets the same puzzle and the archive can be reconstructed exactly. Nothing here is
      entered by hand.
    </p>
    <h3>What the difficulty dots mean</h3>
    <p>
      Difficulty is rated 1 to 5 from land area and land-neighbour count, weighted 65/35 toward
      size. Small countries with few neighbours score highest because they are easy to overshoot
      and have no cluster of near-misses to walk in from.
    </p>

    <p class="cta-row">
      <a href="/globle-answer-today" class="btn btn-primary">See today&rsquo;s answer →</a>
      <a href="/" class="btn btn-ghost">▶ Play Globle Unlimited</a>
    </p>
  </article>
</BaseLayout>

<script>
  const search = document.getElementById('archive-search') as HTMLInputElement | null;
  const empty = document.getElementById('archive-empty');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const months = Array.from(document.querySelectorAll<HTMLElement>('[data-month]'));
  const chips = Array.from(document.querySelectorAll<HTMLElement>('.chip'));

  let region = 'all';
  let query = '';

  function apply() {
    let shown = 0;
    for (const card of cards) {
      const matchesRegion = region === 'all' || card.dataset.region === region;
      const haystack = `${card.dataset.name} ${card.dataset.date}`;
      const show = matchesRegion && (!query || haystack.includes(query));
      // The <li> wrapper is what occupies a grid cell, so hide that.
      const cell = card.parentElement ?? card;
      cell.hidden = !show;
      if (show) shown++;
    }
    for (const month of months) {
      const any = Array.from(month.querySelectorAll<HTMLElement>('[data-card]'))
        .some((c) => !(c.parentElement ?? c).hidden);
      month.hidden = !any;
    }
    if (empty) empty.hidden = shown > 0;
  }

  search?.addEventListener('input', () => {
    query = search.value.trim().toLowerCase();
    apply();
  });

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      region = chip.dataset.region ?? 'all';
      for (const c of chips) c.classList.toggle('is-on', c === chip);
      apply();
    });
  }
</script>

<style>
  .hero {
    background:
      radial-gradient(120% 100% at 70% 0%, var(--bg-glow) 0%, transparent 60%),
      var(--bg-panel);
    border-bottom: 1px solid var(--line);
    padding-block: var(--space-8);
  }
  .crumb { font-size: var(--fs-small); color: var(--text-mute); margin-bottom: var(--space-4); }
  .crumb a { color: var(--text-dim); }
  h1 { font-size: var(--fs-h1); margin-bottom: var(--space-2); }
  .accent { color: var(--accent); }
  .lede { color: var(--text-dim); }

  .tally {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-4);
    margin: var(--space-8) 0;
  }
  .tally dt { font-size: var(--fs-small); color: var(--text-mute); text-transform: uppercase; letter-spacing: 0.08em; }
  .tally dd { margin: var(--space-1) 0 0; color: var(--accent); font-size: 1.6rem; }

  .controls { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; }
  .search { flex: 1 1 260px; }
  .search input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line);
    padding: var(--space-3) var(--space-1);
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--fs-body);
  }
  .search input:focus { outline: none; border-bottom-color: var(--accent); box-shadow: 0 1px 0 0 var(--accent); }
  .search input::placeholder { color: var(--text-mute); }

  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chip {
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-3);
    color: var(--text-dim);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease);
  }
  .chip:hover { color: var(--text); border-color: var(--accent); }
  .chip.is-on { background: var(--accent-dim); border-color: var(--accent); color: var(--accent); }

  .grid-wrap { padding-block: var(--space-8); max-width: var(--wide-width); }
  .empty { color: var(--text-mute); font-style: italic; text-align: center; }

  .month-head {
    margin: var(--space-8) 0 var(--space-3);
    padding-left: var(--space-3);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-mute);
    border-left: 3px solid var(--accent);
  }

  .page { padding-block: var(--space-8) var(--space-12); }
  .unused { background: var(--bg-panel); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: var(--space-3) var(--space-4); }
  .unused summary { cursor: pointer; color: var(--accent); font-weight: 600; }
  .unused p { margin-top: var(--space-3); color: var(--text-dim); font-size: var(--fs-small); line-height: 1.9; }

  .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-block: var(--space-12) var(--space-3); }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .chip { transition: none; }
  }
</style>
