---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnswerHero from '../../components/answer/AnswerHero.astro';
import ClueTiles from '../../components/answer/ClueTiles.astro';
import RevealPanel from '../../components/answer/RevealPanel.astro';
import CountryPlate from '../../components/answer/CountryPlate.astro';
import { answerForDate, shiftISO } from '../../lib/game/daily';
import { COUNTRIES, flag } from '../../lib/game/countries';
import { prettyDate } from '../../lib/game/hint';
import { analyse, teaserFor } from '../../lib/game/analysis';
import { archiveDates, dispatchNoFor, todayISO } from '../../lib/game/archive';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return archiveDates(todayISO()).map((date) => ({ params: { date } }));
}

const { date } = Astro.params as { date: string };
const today = todayISO();

const country = answerForDate(date);
const analysis = analyse(country);
const nice = prettyDate(date);
const dispatchNo = dispatchNoFor(date);
const total = COUNTRIES.length;
const { ladder, bestOpener, obscurity } = analysis;

const prev = shiftISO(date, -1);
const next = shiftISO(date, 1);
const hasPrev = prev >= SITE.launchDate;
const hasNext = next <= today;
const isToday = date === today;

const title = `Globle Answer for ${nice} – Hints and Reveal`;
const description =
  `The Globle Unlimited answer for ${nice}, with the four hints that narrowed it down, a country profile, and the opening guess that would have found it fastest.`;

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: `${SITE.url}/globle-answer-archive/${date}`,
    datePublished: date,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Globle Answer Today', item: `${SITE.url}/globle-answer-today` },
      { '@type': 'ListItem', position: 3, name: 'Archive', item: `${SITE.url}/globle-answer-archive` },
      { '@type': 'ListItem', position: 4, name: nice, item: `${SITE.url}/globle-answer-archive/${date}` },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={`/globle-answer-archive/${date}`} schema={schema}>
  <AnswerHero
    dispatch={`DISPATCH NO. ${dispatchNo}`}
    dateLabel={nice}
    date={date}
    titleLead="Globle Answer for"
    titleAccent={nice}
    teaser={teaserFor(country)}
    live={isToday}
  />

  <p class="crumb container">
    <a href="/">Home</a> › <a href="/globle-answer-today">Answer Today</a> ›
    <a href="/globle-answer-archive"> Archive</a> › {nice}
  </p>

  <section class="core container">
    <h2 class="core-head">Globle Clues &amp; Answer ({date})</h2>

    <h3 class="sub mono">Globle {dispatchNo} Clues</h3>
    <ClueTiles ladder={ladder} total={total} />

    <h3 class="sub mono">Globle {dispatchNo} Answer</h3>
    <RevealPanel label={isToday ? 'Click to reveal the answer' : 'Click to reveal this day’s answer'}>
      <p class="answer">
        The Globle Unlimited answer for {nice} was
        <strong>{flag(country.cca2)} {country.name}</strong>.
      </p>
      <CountryPlate country={country} analysis={analysis} date={date} />
    </RevealPanel>
  </section>

  <nav class="pager container" aria-label="Nearby days">
    {hasPrev
      ? <a class="btn btn-ghost" href={`/globle-answer-archive/${prev}`}>← {prettyDate(prev)}</a>
      : <span></span>}
    {hasNext
      ? <a class="btn btn-ghost" href={`/globle-answer-archive/${next}`}>{prettyDate(next)} →</a>
      : <span></span>}
  </nav>

  <article class="prose page">
    <h2>How Hard Was It?</h2>

    <h3>Difficulty rating</h3>
    <p>
      {country.name} rates <strong>{obscurity.score} of 5 — {obscurity.label}</strong>. The rating
      comes from land area and land-neighbour count, weighted 65/35 toward size: it ranks
      {' '}{obscurity.areaRank} of {total} by area and has {analysis.neighbours} land
      neighbour{analysis.neighbours === 1 ? '' : 's'}.
    </p>

    <h3>The fastest opening guess</h3>
    <p>
      <strong>{bestOpener.name}</strong> was the strongest opener against this answer. From there
      the target reads {bestOpener.distanceKm.toLocaleString('en-US')} km away, a distance shared
      by only {bestOpener.remaining} other candidate{bestOpener.remaining === 1 ? '' : 's'} — so a
      single guess could have cut the field to
      {' '}{bestOpener.remaining + 1} countr{bestOpener.remaining + 1 === 1 ? 'y' : 'ies'}.
    </p>
    <p>
      The value of an opening guess swings enormously depending on where the answer sits. Our
      <a href="/blog/best-globle-starting-country"> opening-country analysis</a> ranks every
      candidate on average performance rather than one lucky day.
    </p>

    <h2 id="vs-official">Which Globle This Answer Is For</h2>
    <p>
      This is <em>Globle Unlimited&rsquo;s</em> own daily puzzle. We are an independent, fan-made
      project, not affiliated with or endorsed by the official Globle by Trainwreck Labs, whose
      answer for this date was a different country drawn from a separate rotation.
    </p>

    <p class="cta-row">
      <a href="/" class="btn btn-primary">▶ Play Globle Unlimited</a>
      <a href="/globle-answer-archive" class="btn btn-ghost">All past answers</a>
    </p>
  </article>
</BaseLayout>

<style>
  .crumb {
    font-size: var(--fs-small);
    color: var(--text-mute);
    padding-block: var(--space-6) var(--space-2);
  }
  .crumb a { color: var(--text-dim); }

  .core {
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6);
    max-width: var(--wide-width);
  }
  .core-head { text-align: center; font-size: var(--fs-h2); margin-bottom: var(--space-8); }
  .sub {
    text-align: center;
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-mute);
    margin-block: var(--space-8) var(--space-3);
  }
  .answer { font-size: 1.15rem; color: var(--text); margin-block: var(--space-6); text-align: center; }

  .pager { display: flex; justify-content: space-between; gap: var(--space-3); padding-block: var(--space-8); flex-wrap: wrap; }

  .page { padding-block: var(--space-4) var(--space-12); }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-block: var(--space-8) var(--space-3); }

  @media (max-width: 640px) {
    .core { padding: var(--space-6) var(--space-4); border-radius: var(--radius); }
  }
</style>
