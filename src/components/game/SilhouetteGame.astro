---
// Interactive Worldle-style silhouette game island. Hydrates client-side.
// No globe / WebGL — a flat outline + distance/direction/proximity clues.
// Reused by /silhouette (countries) and /states (US states) via `variant`.
interface Props {
  variant?: 'countries' | 'states';
}
const { variant = 'countries' } = Astro.props;

const cfg =
  variant === 'states'
    ? {
        noun: 'state', placeholder: 'Enter state name or abbreviation…', ariaInput: 'Enter state name',
        ariaImg: 'Silhouette of the mystery US state', silUrl: '/assets/data/us-states.silhouettes.json',
        shareName: 'Statele Unlimited', sharePath: '/states', statsMode: 'states', maxKm: 6000,
      }
    : {
        noun: 'country', placeholder: 'Enter country name…', ariaInput: 'Enter country name',
        ariaImg: 'Silhouette of the mystery country', silUrl: '/assets/data/silhouettes.json',
        shareName: 'Worldle Unlimited', sharePath: '/silhouette', statsMode: 'silhouette', maxKm: 20000,
      };
---

<div
  class="sgame"
  data-sgame
  data-variant={variant}
  data-sil-url={cfg.silUrl}
  data-noun={cfg.noun}
  data-share-name={cfg.shareName}
  data-share-path={cfg.sharePath}
  data-stats-mode={cfg.statsMode}
  data-max-km={cfg.maxKm}
>
  <!-- Silhouette card -->
  <div class="sil-stage rise" style="--d:120ms">
    <div class="sil-card" data-sil role="img" aria-label={cfg.ariaImg}>
      <svg class="sil-svg" viewBox="0 0 300 300" aria-hidden="true">
        <path data-sil-path d="" />
      </svg>
      <span class="sil-hint mono" data-sil-hint>Loading…</span>
    </div>
  </div>

  <!-- Guess input + autocomplete -->
  <form class="guess-form rise" style="--d:200ms" data-guess-form autocomplete="off">
    <div class="guess-field">
      <input
        type="text"
        class="guess-input"
        data-guess-input
        placeholder={cfg.placeholder}
        aria-label={cfg.ariaInput}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        disabled
      />
      <div class="suggest" data-suggest hidden role="listbox" aria-label="Country suggestions"></div>
    </div>
    <button type="submit" class="btn btn-primary" disabled>Guess</button>
  </form>

  <!-- Progress pips -->
  <div class="pips rise" style="--d:280ms">
    <div class="pip-row" data-pips aria-hidden="true"></div>
    <span class="pip-count mono" data-pipcount>GUESSES 0 / 6</span>
  </div>

  <!-- First-run hint: preview the clue system -->
  <p class="clue-tip rise" style="--d:340ms" data-clue-tip>
    Each guess reveals <strong>distance</strong>, a <strong>direction arrow</strong> &amp; <strong>proximity %</strong>.
  </p>

  <!-- Guess list -->
  <ul class="guess-list" data-list aria-label="Your guesses"></ul>

  <!-- A11y live region -->
  <p class="sr-only" aria-live="polite" data-live></p>

  <!-- End modal (win or reveal) -->
  <div class="modal-overlay" data-modal hidden>
    <div class="modal card" role="dialog" aria-modal="true" aria-label="Round over">
      <div class="modal-emoji" data-modal-emoji>🎉</div>
      <h2 class="modal-title" data-modal-title>You found it!</h2>
      <p class="modal-line">
        The answer was <strong data-modal-country></strong>.
      </p>
      <p class="modal-line" data-modal-guesses-line>
        Solved in <strong class="mono" data-modal-guesses>0</strong> guesses.
      </p>
      <p class="modal-line modal-extra" data-modal-extra hidden></p>
      <div class="modal-actions">
        <button class="btn btn-primary" data-play-again>▶ Play Again</button>
        <button class="btn btn-ghost" data-share>Share</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { initSilhouetteGame } from './silhouette-game';
  const root = document.querySelector<HTMLElement>('[data-sgame]');
  if (root) initSilhouetteGame(root);
</script>

<style>
  .sgame { display: flex; flex-direction: column; align-items: center; }

  /* ---- Silhouette card ---- */
  .sil-stage { display: grid; place-items: center; width: 100%; margin-top: var(--space-4); }
  .sil-card {
    position: relative;
    width: min(400px, 80vw);
    aspect-ratio: 1;
    display: grid; place-items: center;
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-glow);
    overflow: hidden;
  }
  /* faint lat/long grid texture — instrument feel */
  .sil-card::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 30px 30px;
    opacity: 0.5;
    pointer-events: none;
  }
  .sil-svg { width: 100%; height: 100%; position: relative; z-index: 1; }
  .sil-svg path {
    fill: var(--silhouette-fill);
    stroke: var(--silhouette-stroke);
    stroke-width: 1.4;
    stroke-linejoin: round;
    paint-order: stroke;
  }
  .sil-hint { position: absolute; z-index: 2; color: var(--text-dim); font-size: var(--fs-small); }

  /* draw-on animation for the outline */
  .sil-card.drawing path {
    stroke-dasharray: var(--len, 2000);
    stroke-dashoffset: var(--len, 2000);
    animation: sil-draw 1s var(--ease) forwards;
  }
  @keyframes sil-draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .sil-card.drawing path { animation: none; stroke-dashoffset: 0; }
  }

  /* ---- Input + autocomplete (mirrors GlobeGame) ---- */
  .guess-form { display: flex; gap: var(--space-2); justify-content: center; margin-top: var(--space-6); width: 100%; }
  .guess-field { position: relative; width: min(360px, 70vw); }
  .guess-input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--text);
  }
  .guess-input::placeholder { color: var(--text-mute); }
  .guess-input[aria-invalid='true'] { border-color: var(--danger); }
  .guess-input:disabled { opacity: 0.5; }

  .suggest {
    position: absolute;
    top: calc(100% + 6px);
    left: 0; right: 0;
    z-index: 30;
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-panel);
    overflow: hidden;
    text-align: left;
  }
  .sgame :global(.suggest-item) {
    display: block; width: 100%; text-align: left;
    padding: var(--space-2) var(--space-4);
    background: transparent; border: 0; cursor: pointer;
    color: var(--text); font-size: var(--fs-small);
  }
  .sgame :global(.suggest-item:hover), .sgame :global(.suggest-item.active) { background: var(--bg-panel-2); color: var(--accent); }
  .sgame :global(.suggest-error) { padding: var(--space-2) var(--space-4); color: var(--danger); font-size: var(--fs-small); }

  /* ---- Progress pips ---- */
  .pips { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-8); }
  .pip-row { display: flex; gap: var(--space-2); }
  .sgame :global(.pip) {
    width: 12px; height: 12px; border-radius: 50%;
    border: 1.5px solid var(--text-mute);
    background: transparent;
    transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .pip-count { font-size: 0.72rem; letter-spacing: 0.1em; color: var(--text-mute); }

  /* First-run clue hint */
  .clue-tip { margin-top: var(--space-4); color: var(--text-dim); font-size: var(--fs-small); text-align: center; }
  .clue-tip strong { color: var(--accent); font-weight: 600; }
  .clue-tip[hidden] { display: none; }

  /* ---- Guess list ---- */
  .guess-list { list-style: none; padding: 0; margin: var(--space-6) 0 0; width: min(440px, 92vw); display: flex; flex-direction: column; gap: var(--space-1); }
  .sgame :global(.guess-row) {
    display: grid;
    grid-template-columns: 16px 24px 1fr auto auto auto;
    align-items: center; gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    animation: rise var(--dur) var(--ease) both;
  }
  .sgame :global(.guess-row.is-correct) { border-color: var(--win); box-shadow: 0 0 0 1px var(--win); }
  .sgame :global(.swatch) { width: 16px; height: 16px; border-radius: 4px; }
  .sgame :global(.g-name) { color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sgame :global(.g-dist) { color: var(--text-dim); font-size: var(--fs-small); }
  .sgame :global(.g-arrow) { color: var(--accent); font-size: 1.05rem; line-height: 1; width: 1.2em; text-align: center; }
  .sgame :global(.g-abbr) { display: inline-grid; place-items: center; min-width: 24px; height: 18px; padding: 0 4px; border-radius: 4px; background: var(--accent-dim); color: var(--accent); font-size: 0.7rem; font-family: var(--font-mono); }
  .sgame :global(.g-prox) { color: var(--text); font-size: var(--fs-small); min-width: 3ch; text-align: right; }

  /* ---- Modal (mirrors GlobeGame) ---- */
  .modal-overlay[hidden] { display: none; }
  .modal-overlay {
    position: fixed; inset: 0; z-index: 100;
    display: grid; place-items: center;
    background: rgba(11, 22, 34, 0.7);
    backdrop-filter: blur(4px);
    padding: var(--space-4);
    animation: rise var(--dur-fast) var(--ease) both;
  }
  .modal { max-width: 380px; width: 100%; padding: var(--space-8); text-align: center; }
  .modal-emoji { font-size: 2.5rem; }
  .modal-title { margin-top: var(--space-2); }
  .modal-line { color: var(--text-dim); margin-top: var(--space-2); }
  .modal-extra { color: var(--accent); font-family: var(--font-mono); font-size: var(--fs-small); }
  .modal-extra[hidden] { display: none; }
  .modal-actions { display: flex; gap: var(--space-3); justify-content: center; margin-top: var(--space-6); }
</style>
