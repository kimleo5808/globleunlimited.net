---
// Interactive Higher or Lower: Countries island. Two country cards with their
// outlines drawn to one scale; the player says whether the challenger has more
// or fewer people (or km²). Hydrates client-side; no WebGL.
const MODES = [
  ['population', 'Population'],
  ['area', 'Area'],
  ['mixed', 'Mixed'],
] as const;
---

<div class="hgame" data-hgame>
  <div class="hg-top rise" style="--d:120ms">
    <div class="tabs" role="group" aria-label="What to compare">
      {MODES.map(([key, label]) => (
        <button type="button" class="tab" data-mode={key} aria-pressed="false">{label}</button>
      ))}
    </div>
    <dl class="score mono">
      <div><dt>Streak</dt><dd data-streak>0</dd></div>
      <div><dt>Best</dt><dd data-best>0</dd></div>
    </dl>
  </div>

  <div class="hg-cards rise" style="--d:200ms">
    {['current', 'challenger'].map((role) => (
      <article class={`hcard hcard-${role}`} data-card={role}>
        <p class="hc-tag mono" data-tag>{role === 'current' ? 'Current' : 'Challenger'}</p>
        <div class="hc-shape" aria-hidden="true">
          <svg data-shape width="200" height="200" viewBox="-100 -100 200 200"><path d="" vector-effect="non-scaling-stroke" /></svg>
          <span class="hc-enlarged mono" data-enlarged hidden>enlarged · too small at this scale</span>
        </div>
        <h3 class="hc-name"><span data-flag></span> <span data-name>…</span></h3>
        <p class="hc-other mono" data-other></p>
        <p class="hc-value mono" data-value>…</p>
        <p class="hc-unit mono" data-unit>People</p>
        {role === 'challenger' && (
          <div class="hc-actions">
            <button type="button" class="btn answer answer-higher" data-answer="higher" aria-keyshortcuts="ArrowUp H">▲ Higher</button>
            <button type="button" class="btn answer answer-lower" data-answer="lower" aria-keyshortcuts="ArrowDown L">▼ Lower</button>
          </div>
        )}
      </article>
    ))}
    <span class="vs" aria-hidden="true">vs</span>
  </div>

  <div class="hg-compare" data-compare aria-hidden="true">
    <div class="bar-row"><span class="bar-label mono" data-bar-a-label></span><span class="bar" data-bar-a></span></div>
    <div class="bar-row"><span class="bar-label mono" data-bar-b-label></span><span class="bar" data-bar-b></span></div>
    <p class="compare-line" data-compare-line></p>
  </div>

  <!-- Shown when the end-of-run modal is closed, to bring it back -->
  <button type="button" class="btn btn-ghost round-result" data-reopen hidden>Run over · See result</button>

  <p class="hg-keys mono">Keys: ↑ / H = higher · ↓ / L = lower · <span data-source></span></p>
  <p class="sr-only" aria-live="polite" data-live></p>

  <div class="modal-overlay" data-modal hidden>
    <div class="modal card" role="dialog" aria-modal="true" aria-label="Run over">
      <button type="button" class="modal-close" data-modal-close aria-label="Close">✕</button>
      <div class="modal-emoji" data-modal-emoji>🔥</div>
      <h2 class="modal-title" data-modal-title>Run over</h2>
      <p class="modal-line" data-modal-score></p>
      <p class="modal-line" data-modal-why></p>
      <p class="modal-line modal-extra" data-modal-trap hidden></p>
      <div class="modal-actions">
        <button class="btn btn-primary" data-play-again>▶ Play again</button>
        <button class="btn btn-ghost" data-share>Share</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { initHigherOrLower } from './higher-or-lower-game';
  const root = document.querySelector<HTMLElement>('[data-hgame]');
  if (root) initHigherOrLower(root);
</script>

<style>
  .hgame { display: flex; flex-direction: column; align-items: center; margin-top: var(--space-6); }

  .hg-top { width: 100%; max-width: 1060px; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }
  .tabs { display: flex; gap: var(--space-2); }
  .tab {
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-4);
    color: var(--text-dim);
    font-family: var(--font-body);
    font-weight: 600;
    cursor: pointer;
  }
  .tab:hover { color: var(--text); border-color: var(--accent); }
  .tab[aria-pressed='true'] { background: var(--accent-dim); border-color: var(--accent); color: var(--accent); }
  .score { display: flex; gap: var(--space-6); margin: 0; }
  .score div { text-align: right; }
  .score dt { font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-mute); }
  .score dd { margin: 0; font-size: 1.6rem; color: var(--accent); }
  .score div + div dd { color: var(--text-dim); }

  .hg-cards {
    position: relative;
    width: 100%;
    max-width: 1060px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    margin-top: var(--space-6);
    text-align: left;
  }
  .hcard {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'tag   shape'
      'name  shape'
      'other shape'
      'value value'
      'unit  unit'
      'act   act';
    align-content: start;
    min-height: 400px;
    padding: var(--space-6);
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-panel);
  }
  .hcard.is-leaving { animation: slide-out var(--dur) var(--ease) both; }
  .hcard.is-arriving { animation: rise var(--dur) var(--ease) both; }
  .hcard.is-wrong { animation: shake 0.2s linear 2; }
  @keyframes slide-out { to { opacity: 0; transform: translateX(-24px); } }
  @keyframes shake { 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }

  .hc-tag { grid-area: tag; font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-mute); }
  .hc-shape { grid-area: shape; position: relative; width: 200px; height: 200px; display: grid; place-items: center; }
  .hc-shape svg { width: 100%; height: 100%; overflow: visible; }
  .hc-shape path { fill: var(--silhouette-fill, #1b3d4e); stroke: var(--silhouette-stroke, #0c2531); stroke-width: 1.5; stroke-linejoin: round; }
  .hcard-challenger .hc-shape path { fill-opacity: 0.45; }
  .hc-enlarged { position: absolute; bottom: 0; right: 0; font-size: 0.62rem; color: var(--text-mute); }
  .hc-enlarged[hidden] { display: none; }
  .hc-name { grid-area: name; margin-top: var(--space-2); font-size: clamp(1.6rem, 3vw, 2.6rem); line-height: 1.1; }
  .hc-name :global(.flag-img) { width: 30px; height: 22px; vertical-align: 0.15em; }
  .hc-other { grid-area: other; margin-top: var(--space-2); font-size: var(--fs-small); color: var(--text-dim); }
  .hc-value { grid-area: value; margin-top: var(--space-6); font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1; color: var(--accent); font-variant-numeric: tabular-nums; }
  .hcard-challenger .hc-value { color: var(--text-mute); }
  .hcard-challenger.is-revealed .hc-value { color: var(--accent); }
  .hc-unit { grid-area: unit; margin-top: var(--space-1); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-mute); }
  .hc-actions { grid-area: act; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin-top: var(--space-6); }
  .answer { min-height: 56px; font-size: 1.05rem; justify-content: center; }
  .answer-higher { background: var(--win); color: #fff; border: 0; }
  .answer-higher:hover { color: #fff; filter: brightness(1.08); }
  .answer-lower { background: transparent; color: var(--danger); border: 2px solid var(--danger); }
  .answer:disabled { opacity: 0.45; cursor: default; }

  .vs {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: 64px; height: 64px;
    display: grid; place-items: center;
    background: var(--bg-panel);
    border: 2px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.4rem;
  }

  .hg-compare { width: 100%; max-width: 1060px; margin-top: var(--space-6); min-height: 92px; visibility: hidden; }
  .hg-compare.is-shown { visibility: visible; }
  .bar-row { display: grid; grid-template-columns: 160px 1fr; align-items: center; gap: var(--space-3); margin-bottom: var(--space-2); }
  .bar-label { font-size: 0.75rem; color: var(--text-dim); text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar { height: 14px; border-radius: 7px; background: var(--accent); width: 0; transition: width var(--dur-slow) var(--ease); }
  .bar-row + .bar-row .bar { background: var(--text-mute); }
  .compare-line { text-align: center; margin-top: var(--space-2); color: var(--text); font-weight: 600; }

  .hg-keys { margin-top: var(--space-4); font-size: 0.72rem; color: var(--text-mute); text-align: center; }

  /* ---- Modal ---- */
  .modal-overlay[hidden] { display: none; }
  .modal-overlay {
    position: fixed; inset: 0; z-index: 100;
    display: grid; place-items: center;
    background: rgba(11, 22, 34, 0.7);
    backdrop-filter: blur(4px);
    padding: var(--space-4);
    animation: rise var(--dur-fast) var(--ease) both;
  }
  .modal { max-width: 420px; width: 100%; padding: var(--space-8); text-align: center; }
  .modal-emoji { font-size: 2.5rem; }
  .modal-title { margin-top: var(--space-2); }
  .modal-line { color: var(--text-dim); margin-top: var(--space-2); }
  .modal-extra { color: var(--accent); font-size: var(--fs-small); }
  .modal-extra[hidden] { display: none; }
  .modal-actions { display: flex; gap: var(--space-3); justify-content: center; margin-top: var(--space-6); }

  @media (max-width: 900px) {
    .hg-cards { grid-template-columns: 1fr; gap: var(--space-6); margin-top: var(--space-4); }
    .hcard { min-height: 0; padding: var(--space-4); }
    .hc-shape { width: 96px; height: 96px; }
    .hc-name { font-size: 1.5rem; }
    .hc-value { margin-top: var(--space-3); font-size: 2.1rem; }
    /* Buttons above the hidden figure, so a phone shows them without scrolling. */
    .hcard-challenger {
      grid-template-areas:
        'tag   shape'
        'name  shape'
        'other shape'
        'act   act'
        'value value'
        'unit  unit';
    }
    .hcard-challenger .hc-actions { margin-top: var(--space-4); }
    .vs { width: 44px; height: 44px; font-size: 1rem; }
    .bar-row { grid-template-columns: 100px 1fr; }
  }
  @media (max-width: 480px) {
    .hg-top { flex-wrap: nowrap; }
    .tab { padding: var(--space-1) var(--space-3); font-size: 0.85rem; }
    .score { gap: var(--space-3); }
    .score dd { font-size: 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hcard.is-leaving, .hcard.is-arriving, .hcard.is-wrong { animation: none; }
    .bar { transition: none; }
  }
</style>
