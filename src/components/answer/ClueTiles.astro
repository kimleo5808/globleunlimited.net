---
// The four hints as a horizontal row of tiles rather than a stacked list, so
// the whole clue set is scannable in one glance. Each tile is a <details>, so
// opening one is native, keyboard-operable and needs no JS. Opened tiles fill
// with the next colour of the game's own heat ramp.
import type { Rung } from '../../lib/game/analysis';

interface Props {
  ladder: Rung[];
  /** Total countries in the answer pool, shown as the starting figure. */
  total: number;
}

const { ladder, total } = Astro.props;
---

<div class="clues">
  <p class="hint-bar">
    <span aria-hidden="true">💡</span>
    Tap each clue to open it. The counter shows how many of the {total} countries still fit.
  </p>

  <ol class="tiles">
    {ladder.map((rung, i) => (
      <li>
        <details class={`tile tile-${i}`}>
          <summary>
            <span class="num mono">#{i + 1}</span>
            <span class="label">{rung.label}</span>
            <span class="count mono">{rung.remaining} left</span>
          </summary>
          <p class="clue">{rung.clue}</p>
        </details>
      </li>
    ))}
  </ol>
</div>

<style>
  .clues { margin: var(--space-6) 0; }

  .hint-bar {
    text-align: center;
    color: var(--text-mute);
    font-size: var(--fs-small);
    margin-bottom: var(--space-4);
  }

  .tiles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .tile {
    height: 100%;
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .tile:hover { transform: translateY(-2px); border-color: var(--accent); }

  summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-3);
    cursor: pointer;
    list-style: none;
    text-align: center;
    min-height: 48px;
  }
  summary::-webkit-details-marker { display: none; }

  .num {
    font-size: var(--fs-small);
    color: var(--text-mute);
    letter-spacing: 0.08em;
  }
  .label {
    color: var(--text);
    font-weight: 600;
    font-size: var(--fs-small);
    line-height: 1.3;
  }
  .count {
    font-size: 0.75rem;
    color: var(--text-mute);
    padding: 2px var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
  }

  .clue {
    margin: 0;
    padding: 0 var(--space-3) var(--space-4);
    text-align: center;
    color: var(--bg-deep);
    font-weight: 700;
    font-size: var(--fs-small);
  }

  /* An opened tile fills with its rung's heat colour: cold first, hot last. */
  .tile[open] { border-color: transparent; }
  .tile-0[open] { background: var(--heat-0); }
  .tile-1[open] { background: var(--heat-1); }
  .tile-2[open] { background: var(--heat-2); }
  .tile-3[open] { background: var(--heat-3); }

  .tile-0[open] .num, .tile-1[open] .num,
  .tile-2[open] .num, .tile-3[open] .num { color: rgba(11, 22, 34, 0.65); }
  .tile-0[open] .label, .tile-1[open] .label,
  .tile-2[open] .label, .tile-3[open] .label { color: var(--bg-deep); }
  .tile-0[open] .count, .tile-1[open] .count,
  .tile-2[open] .count, .tile-3[open] .count {
    color: var(--bg-deep);
    border-color: rgba(11, 22, 34, 0.35);
  }
  /* The two hottest tiles are dark enough to need light text. */
  .tile-3[open] .label, .tile-3[open] .clue { color: #fff; }
  .tile-3[open] .num { color: rgba(255, 255, 255, 0.7); }
  .tile-3[open] .count { color: #fff; border-color: rgba(255, 255, 255, 0.4); }

  @media (max-width: 720px) {
    .tiles { grid-template-columns: repeat(2, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile { transition: none; }
  }
</style>
