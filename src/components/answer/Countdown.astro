---
// Return-visit hook: how long until the next daily unlocks at 00:00 UTC.
//
// The markup ships with em-dash placeholders rather than real numbers. A CDN
// caches this page for hours, so any figure rendered at build time would be
// wrong by the time a visitor sees it; the clock is filled in on mount.
//
// The page is static and only rebuilt a few minutes after the rollover, so for
// that window it still shows yesterday's answer. `date` is the day this build
// was made for; when it no longer matches the UTC date, the script fills the
// page's [data-stale-note] banner. A visitor who had the page open across the
// rollover also gets one automatic reload once the rebuild has had time to land.
interface Props {
  /** ISO date this build of the page answers. */
  date: string;
}

const { date } = Astro.props;
---

<section class="countdown" data-page-date={date}>
  <h2 class="ct-head">Next Daily Puzzle Unlocks In</h2>

  <div class="dials" data-countdown>
    <div class="dial"><span class="num mono" data-ct-h>--</span><span class="unit">Hours</span></div>
    <div class="dial"><span class="num mono" data-ct-m>--</span><span class="unit">Minutes</span></div>
    <div class="dial"><span class="num mono" data-ct-s>--</span><span class="unit">Seconds</span></div>
  </div>

  <p class="ct-note">
    <span aria-hidden="true">💡</span>
    A new mystery country unlocks at 00:00 UTC<span data-ct-local></span>.
  </p>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-page-date]');
  const host = document.querySelector<HTMLElement>('[data-countdown]');
  const hEl = document.querySelector<HTMLElement>('[data-ct-h]');
  const mEl = document.querySelector<HTMLElement>('[data-ct-m]');
  const sEl = document.querySelector<HTMLElement>('[data-ct-s]');
  const localEl = document.querySelector<HTMLElement>('[data-ct-local]');
  const staleNote = document.querySelector<HTMLElement>('[data-stale-note]');

  const pageDate = section?.dataset.pageDate ?? '';
  /** How long to wait before checking whether the rebuilt page is live. */
  const RETRY_MS = 3 * 60 * 1000;

  const todayUTC = () => new Date().toISOString().slice(0, 10);

  function nextResetUTC(): Date {
    const now = new Date();
    const next = new Date(now);
    next.setUTCHours(24, 0, 0, 0); // rolls into tomorrow 00:00 UTC
    return next;
  }

  const pad = (n: number) => String(Math.floor(n)).padStart(2, '0');

  const isStale = () => pageDate !== '' && pageDate < todayUTC();
  let staleShown = false;

  /** The puzzle has rolled over but this copy of the page has not been rebuilt
   *  yet. Say so rather than presenting yesterday's answer as today's. Only a
   *  rollover seen live triggers the reload, so a page that is still stale
   *  after it (or a visitor whose clock runs fast) never loops. */
  function markStale(reload: boolean) {
    if (staleShown) return;
    staleShown = true;
    if (staleNote) {
      staleNote.textContent =
        `The ${todayUTC()} puzzle is already live, and this page is being rebuilt for it. ` +
        `Until it refreshes, the answer below is the one for ${pageDate}.`;
      staleNote.hidden = false;
    }
    if (reload) setTimeout(() => location.reload(), RETRY_MS);
  }

  const staleAtLoad = isStale();
  if (staleAtLoad) markStale(false);

  function tick() {
    if (!host) return;
    if (!staleAtLoad && isStale()) markStale(true);
    const ms = nextResetUTC().getTime() - Date.now();
    const total = ms / 1000;
    if (hEl) hEl.textContent = pad(total / 3600);
    if (mEl) mEl.textContent = pad((total % 3600) / 60);
    if (sEl) sEl.textContent = pad(total % 60);
  }

  if (host) {
    // Show the reset in the visitor's own clock, which is the whole question
    // people are actually asking when they search for the reset time.
    if (localEl) {
      // Forced to en-US: the surrounding copy is English, so borrowing the
      // browser's locale here produces sentences in two languages.
      const local = nextResetUTC().toLocaleString('en-US', {
        weekday: 'short',
        hour: 'numeric',
        minute: '2-digit',
      });
      localEl.textContent = ` — ${local} where you are`;
    }
    tick();
    setInterval(tick, 1000);
  }
</script>
<style>
  .countdown {
    text-align: center;
    padding: var(--space-12) var(--space-4);
    border-block: 1px solid var(--line);
    margin-block: var(--space-12);
  }

  .ct-head {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-8);
    /* Overrides the .prose heading rule; this one is centred, not rail-marked. */
    border-left: 0;
    padding-left: 0;
    margin-top: 0;
  }

  .dials {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .dial {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 140px;
    padding: var(--space-6) var(--space-4);
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .num {
    font-size: 2.6rem;
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .unit {
    font-size: var(--fs-small);
    color: var(--text-mute);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ct-note {
    margin-top: var(--space-6);
    color: var(--text-mute);
    font-size: var(--fs-small);
  }

  @media (max-width: 560px) {
    .dial { min-width: 92px; padding: var(--space-4) var(--space-3); }
    .num { font-size: 1.9rem; }
  }
</style>
